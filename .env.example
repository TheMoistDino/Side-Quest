# ==========================================
# Fetch.ai & Agentverse Backend Configuration
# ==========================================

# Agentverse Credentials & Seed
AGENTVERSE_KEY=your_agentverse_api_key_here
AGENT_SEED_PHRASE=fitlens

# Agent Server Configuration
PORT=8000
AGENT_ENDPOINT=https://liqueur-customize-nearby.ngrok-free.dev/submit
AGENT_NAME=Quest Orchestrator

# Subagent Seed Phrases (Deterministic Bureau Addresses)
SCOUT_SEED_PHRASE=scout-subagent-seed-phrase-la-hacks-quest
TRANSIT_SEED_PHRASE=transit-subagent-seed-phrase-la-hacks-quest
BUDGET_SEED_PHRASE=budget-subagent-seed-phrase-la-hacks-quest

# Optional External API Keys (Graceful fallbacks are built-in if omitted)
TAVILY_API_KEY=
SERPAPI_API_KEY=
GOOGLE_MAPS_API_KEY=
ASI1_API_KEY=

# ==========================================
# Next.js Frontend Configuration
# ==========================================

# Frontend: "true" (default) serves lib/mock.ts data; "false" calls POST /api/quest
NEXT_PUBLIC_USE_MOCK=true

# Optional, mock only: "error" or "empty" to preview those states
# NEXT_PUBLIC_MOCK_SCENARIO=
